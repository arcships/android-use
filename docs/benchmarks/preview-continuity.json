{
  "scope": "Development acceptance of continuous preview, not physical-device coverage or a statistical benchmark. Different trials used different source stages and emulator rendering settings.",
  "environment": {
    "android_api": 35,
    "emulator": "Android Emulator 35.6.11.0, arm64, four virtual cores, 2 GiB guest RAM",
    "host": "macOS Apple Silicon (Apple M4)",
    "rendering": "Original AVD GPU disabled; final runs override with -gpu host. No unrelated host processes were stopped.",
    "physical_device_used": false
  },
  "acceptance": {
    "moving_fixture_update_ms": 100,
    "long_run_seconds": 190,
    "forced_legacy_segment_seconds": 2,
    "motion_gap_target_seconds": 2,
    "passed_requires": "More than one distinct decoded picture per second, exactly one ADB process and decoder, no reported errors, consumer/publisher gaps below 2 seconds; forced legacy observes at least three encoder PIDs, native mode must detect unlimited capability.",
    "browser_checks": "Bounded known-health recovery keeps image and hides overlay; disables phone actions until a new sequence. Persistent recovery, disconnection and authentication clear it."
  },
  "retained_unserialized_failures": [
    {
      "stage": "Initial probe",
      "result": "Help stderr was not included; fallback capture replaced host pipelines across the 170-second boundary. Corrected stderr probe and close-during-health race."
    },
    {
      "stage": "Direct AVIO experiment",
      "result": "No decoded first frame within 15 seconds; failed and removed -avioflags direct. No JSON report was produced."
    },
    {
      "stage": "Raw packet-size hypothesis ruled out",
      "result": "A paced 60-access-unit / 1856-byte synthetic H.264 stream produced its first decoded frame at 0.104 seconds with the default 1024-byte raw packet size and 0.107 seconds with 128; both continued at about 0.1-second intervals. Packet-size tuning was not added to production."
    }
  ],
